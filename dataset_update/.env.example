# 复制为 dataset_update/.env 后填写（.env 不会被 Git 跟踪）
# cp dataset_update/.env.example dataset_update/.env

# MinIO
MINIO_ENDPOINT=your-minio-host:30090
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET=your-bucket
MINIO_USER_PREFIX=your-username

# Hugging Face（上传数据集时使用；也可使用 huggingface-cli login）
# HF_TOKEN=hf_xxx

# 可选：HF 仓库命名空间，上传时 repo_id 为 {HF_REPO_NAMESPACE}/{本地 repo_id}
# HF_REPO_NAMESPACE=your-hf-username

# 本地数据集根目录（可选）
# DATASET_ROOT=/home/franka/lqz/Data
